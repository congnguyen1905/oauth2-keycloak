{
  "version": 3,
  "name": "OAuth2 Demo Gateway",
  "port": 8888,
  "host": "0.0.0.0",
  "timeout": "30s",
  "cache_ttl": "30s",
  "output_encoding": "json",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "security/cors": {
      "allow_origins": [
        "http://localhost:3000",
        "http://localhost:3031",
        "http://127.0.0.1:3031"
      ],
      "allow_methods": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Origin",
        "origin",
        "Authorization",
        "authorization",
        "Content-Type",
        "content-type",
        "Accept",
        "accept",
        "X-Api-Version",
        "x-api-version",
        "X-Session-Id",
        "x-session-id",
        "X-Tenant-Id",
        "x-tenant-id",
        "X-Tenant-ID"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type"
      ],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
