{
  "version": 3,
  "name": "OAuth2 Demo Gateway",
  "port": 8888,
  "host": "0.0.0.0",
  "timeout": "30s",
  "cache_ttl": "30s",
  "output_encoding": "json",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "security/cors": {
      "allow_origins": ["http://localhost:3000", "http://localhost:3031", "http://127.0.0.1:3031"],
      "allow_methods": ["GET", "HEAD", "POST", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Accept"],
      "expose_headers": ["Content-Length", "Content-Type"],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/auth/login",
          "host": ["http://auth-service:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/auth/logout",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/auth/logout",
          "host": ["http://auth-service:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/auth/validate",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/auth/validate",
          "host": ["http://auth-service:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/auth/session/{sessionID}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/auth/session/{sessionID}",
          "host": ["http://auth-service:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/introspect",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/introspect",
          "host": ["http://auth-service:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/health",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/health",
          "host": ["http://auth-service:8082"],
          "encoding": "json"
        }
      ]
    },
    {
      "endpoint": "/api/inventory/{rest}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/inventory/{rest}",
          "host": ["http://host.docker.internal:8001"],
          "encoding": "json",
          "headers": {
            "X-Api-Version": ["1"]
          }
        }
      ]
    },
    {
      "endpoint": "/api/inventory/{rest}",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/inventory/{rest}",
          "host": ["http://host.docker.internal:8001"],
          "encoding": "json",
          "headers": {
            "X-Api-Version": ["1"]
          }
        }
      ]
    },
    {
      "endpoint": "/api/inventory/{rest}",
      "method": "PUT",
      "backend": [
        {
          "url_pattern": "/inventory/{rest}",
          "host": ["http://host.docker.internal:8001"],
          "encoding": "json",
          "headers": {
            "X-Api-Version": ["1"]
          }
        }
      ]
    },
    {
      "endpoint": "/api/inventory/{rest}",
      "method": "DELETE",
      "backend": [
        {
          "url_pattern": "/inventory/{rest}",
          "host": ["http://host.docker.internal:8001"],
          "encoding": "json",
          "headers": {
            "X-Api-Version": ["1"]
          }
        }
      ]
    }
  ]
}
